{
  "_doc": [
    "Maps each row of 'Travel Desk Stages- mails - Triggers.xlsx' (Final tab) onto one or more",
    "mail_templates records. Source of truth for the seed migration; edit this, then re-run",
    "  python scripts/email-templates/generate_seed.py",
    "",
    "Trigger tuple is (event, audience, context_key).",
    "  event       - TravelEvent value, matches types.ts",
    "  audience    - employee | manager | pnc | finance | escalation_owner",
    "  context_key - nullable discriminator used when several sheet rows share one event+audience",
    "                but carry different copy. null = the default/fallback template for that pair.",
    "",
    "from_status / to_status are stored for documentation, UI display and validation.",
    "They are NOT used for template resolution - context_key is.",
    "",
    "cc_rule     - default | default_finance | default_manager | manager | default_manager_if_approved",
    "body_from   - row number to copy the rendered body from (used by the sheet's merged rows)"
  ],

  "emit": [
    { "row": "2",   "event": "POLICY_VIOLATION_DETECTED",        "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "3",   "event": "POLICY_VIOLATION_DETECTED",        "audience": "manager",          "context_key": null,                             "cc_rule": "default" },
    { "row": "4",   "event": "POLICY_EVALUATION_PASSED",         "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "5",   "event": "MANAGER_APPROVED",                 "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "7",   "event": "MANAGER_REJECTED",                 "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "8",   "event": "EMPLOYEE_CANCELLED_PRE_APPROVAL",  "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "9",   "event": "EMPLOYEE_CANCELLED_PRE_APPROVAL",  "audience": "manager",          "context_key": null,                             "cc_rule": "default" },

    { "row": "12",  "event": "POLICY_VIOLATION_DETECTED",        "audience": "employee",         "context_key": "resubmit_after_manager_rejection", "cc_rule": "default" },
    { "row": "13",  "event": "POLICY_VIOLATION_DETECTED",        "audience": "manager",          "context_key": "resubmit_after_manager_rejection", "cc_rule": "default" },
    { "row": "14",  "event": "POLICY_EVALUATION_PASSED",         "audience": "employee",         "context_key": "resubmit_after_manager_rejection", "cc_rule": "default" },

    { "row": "15",  "event": "PNC_REJECTED",                     "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "18a", "event": "POLICY_VIOLATION_DETECTED",        "audience": "employee",         "context_key": "resubmit_after_pnc_rejection",   "cc_rule": "default", "body_from": "12" },
    { "row": "18b", "event": "POLICY_VIOLATION_DETECTED",        "audience": "manager",          "context_key": "resubmit_after_pnc_rejection",   "cc_rule": "default", "body_from": "13" },
    { "row": "19",  "event": "POLICY_EVALUATION_PASSED",         "audience": "employee",         "context_key": "resubmit_after_pnc_rejection",   "cc_rule": "default" },

    { "row": "21",  "event": "INFO_REQUESTED",                   "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "22",  "event": "BOOKING_CONFIRMED",                "audience": "employee",         "context_key": null,                             "cc_rule": "default" },

    { "row": "23",  "event": "CANCELLATION_REQUESTED",           "audience": "pnc",              "context_key": null,                             "cc_rule": "default" },
    { "row": "24",  "event": "CANCELLATION_REQUESTED",           "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "35",  "event": "CANCELLATION_REQUESTED",           "audience": "employee",         "context_key": "post_booking",                   "cc_rule": "default" },

    { "row": "25",  "event": "INFO_PROVIDED",                    "audience": "pnc",              "context_key": null,                             "cc_rule": "default" },
    { "row": "26",  "event": "INFO_REQUEST_REMINDER_24H",        "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "26b", "event": "INFO_REQUEST_REMINDER_72H",        "audience": "employee",         "context_key": null,                             "cc_rule": "default_manager" },
    { "row": "27",  "event": "INFO_REQUEST_ESCALATED",           "audience": "escalation_owner", "context_key": null,                             "cc_rule": "manager" },
    { "row": "28",  "event": "INFO_REQUEST_EXPIRED",             "audience": "employee",         "context_key": null,                             "cc_rule": "default_manager" },

    { "row": "29",  "event": "BOOKING_UPDATED",                  "audience": "employee",         "context_key": null,                             "cc_rule": "default" },

    { "row": "33",  "event": "CANCELLATION_PROCESSED_EMPLOYEE",  "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "37",  "event": "CANCELLATION_PROCESSED_EMPLOYEE",  "audience": "employee",         "context_key": "post_booking",                   "cc_rule": "default" },

    { "row": "40",  "event": "PNC_CANCELLATION",                 "audience": "employee",         "context_key": null,                             "cc_rule": "default_manager_if_approved" },

    { "row": "43",  "event": "PARTIAL_CANCELLATION",             "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "45",  "event": "SEGMENT_REFUND_COMPLETED",         "audience": "employee",         "context_key": null,                             "cc_rule": "default" },

    { "row": "46",  "event": "PARTIAL_REFUND_RECEIVED",          "audience": "employee",         "context_key": null,                             "cc_rule": "default_finance" },
    { "row": "47",  "event": "REFUND_COMPLETED",                 "audience": "employee",         "context_key": null,                             "cc_rule": "default_finance" },
    { "row": "49",  "event": "REFUND_COMPLETED",                 "audience": "employee",         "context_key": "after_partial_refund",           "cc_rule": "default_finance" },
    { "row": "48",  "event": "REFUND_WRITTEN_OFF",               "audience": "employee",         "context_key": null,                             "cc_rule": "default_finance" },
    { "row": "50",  "event": "REFUND_WRITTEN_OFF",               "audience": "employee",         "context_key": "after_partial_refund",           "cc_rule": "default_finance" },
    { "row": "51",  "event": "REFUND_RECONCILIATION_COMPLETED",  "audience": "employee",         "context_key": null,                             "cc_rule": "default" },
    { "row": "52",  "event": "REFUND_RECONCILIATION_COMPLETED",  "audience": "employee",         "context_key": "after_write_off",                "cc_rule": "default", "body_from": "51" },
    { "row": "53",  "event": "REFUND_DISPUTED",                  "audience": "finance",          "context_key": null,                             "cc_rule": "default" },

    { "row": "57",  "event": "RETROACTIVE_BOOKING_RECORDED",     "audience": "employee",         "context_key": null,                             "cc_rule": "default" }
  ],

  "authored": {
    "_doc": [
      "Sheet row 33 carries a subject but 'Na' in both the Email Template and Revised Email Template",
      "columns, so there is no body to import. The copy below is written to the sheet's own brief for",
      "that row ('States plainly that no money is owed') and to the house voice of the surrounding rows.",
      "REVIEW THIS COPY before go-live - it is the only body in the seed not taken from the sheet."
    ],
    "33": {
      "subject": "Travel Request Cancelled - {{submissionId}}",
      "body": [
        "Hi {{requester_name}},",
        "",
        "Your travel request {{submissionId}} has been cancelled, as you asked.",
        "",
        "Route: {{origin}} to {{destination}}",
        "Date: {{departure_date}}",
        "",
        "Nothing had been booked on this request, so there is no cancellation charge and nothing is owed by you.",
        "",
        "If you need to travel after all, please raise a fresh request on the Travel Desk.",
        "",
        "View Request: Travel Desk",
        "",
        "Best regards,",
        "",
        "Navgurukul Travel Desk"
      ]
    }
  },

  "silent": {
    "_doc": "Sheet rows that deliberately send no email. Recorded so the absence is intentional and testable.",
    "1":   "REQUEST_SUBMITTED - next transition carries the notification",
    "6":   "APPROVAL_COMPLETED - row 5 already told the employee",
    "10":  "REQUEST_EDIT_STARTED",
    "11":  "REQUEST_RESUBMITTED - re-evaluation result carries it",
    "16":  "REQUEST_EDIT_STARTED",
    "17":  "REQUEST_RESUBMITTED",
    "20":  "PNC_STARTED_PROCESSING - employee already told at row 4/14/19",
    "30":  "TICKET_DOCUMENT_REPLACED - deliberately silent, document housekeeping",
    "31":  "BOOKING_DETAIL_EDITED - non-material edit",
    "32":  "merged into rows 23 and 24",
    "34":  "CANCELLATION_CLOSED_PRE_BOOKING - row 33 closed it out",
    "36":  "CANCELLATION_REQUEST_ASSIGNED - merged into row 23",
    "38":  "REFUND_PROCESS_STARTED - row 37 already said recovery underway",
    "41":  "REFUND_PROCESS_STARTED",
    "42":  "NO_REFUND_REQUIRED after PNC cancellation - row 40 already covered it",
    "44":  "SEGMENT_REFUND_PENDING",
    "54":  "TRAVEL_DATE_REACHED",
    "55":  "TRIP_COMPLETED - deliberate, carries no action",
    "58":  "BOOKING_DOCUMENT_UPDATED - document housekeeping"
  }
}
